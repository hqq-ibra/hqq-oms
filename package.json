{
  "name": "hqq-oms",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm -w apps/api run start:dev",
    "dev:web": "npm -w apps/web run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm -w apps/api run build",
    "build:web": "npm -w apps/web run build",
    "db:migrate": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "npx ts-node prisma/seed.ts",
    "db:generate": "npx prisma generate --schema prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema prisma/schema.prisma",
    "lint": "eslint apps packages --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "concurrently": "^9.2.1",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  },
  "overrides": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  }
}
